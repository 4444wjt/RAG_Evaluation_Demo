{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://veriscope.local/schemas/parent-context.v1.schema.json",
  "title":"Parent context preparation contracts, not a quality gate",
  "$defs":{
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "binding":{
      "type":"object","additionalProperties":false,
      "required":["schema","source_format","structure_assertion","source_sha256","segments_sha256","document_id","dataset_id","metadata_positions"],
      "properties":{
        "schema":{"const":"ParentContextBindingV1"},
        "source_format":{"const":"blank-line-articles-v1"},
        "structure_assertion":{"const":"operator-declared-complete-parent-blocks"},
        "source_sha256":{"$ref":"#/$defs/sha256"},"segments_sha256":{"$ref":"#/$defs/sha256"},
        "document_id":{"type":"string","minLength":1,"maxLength":512},
        "dataset_id":{"type":"string","minLength":1,"maxLength":512},
        "metadata_positions":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1}}
      }
    },
    "retrieval":{
      "type":"object","required":["schema","records"],
      "properties":{"schema":{"const":"CitationResourcesV1"},"records":{"type":"array","minItems":1,"maxItems":1,
        "items":{"type":"object","required":["message_id","conversation_id","resources"],"properties":{
          "message_id":{"type":"string","minLength":1},"conversation_id":{"type":"string","minLength":1},
          "resources":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","required":["segment_id","document_id","dataset_id","content"],"properties":{
            "segment_id":{"type":"string","minLength":1},"document_id":{"type":"string","minLength":1},"dataset_id":{"type":"string","minLength":1},"content":{"type":"string"}
          }}}
        }}}}
    },
    "request":{
      "type":"object","additionalProperties":false,"required":["schema","files","max_context_bytes"],
      "properties":{"schema":{"const":"ParentContextRequestV1"},"max_context_bytes":{"type":"integer","minimum":1,"maximum":8388608},
        "files":{"type":"object","additionalProperties":false,"required":["source","segments","retrieval","binding"],"properties":{
          "source":{"type":"string","minLength":1,"contentEncoding":"base64"},"segments":{"type":"string","minLength":1,"contentEncoding":"base64"},
          "retrieval":{"type":"string","minLength":1,"contentEncoding":"base64"},"binding":{"type":"string","minLength":1,"contentEncoding":"base64"}}}}
    },
    "report":{
      "type":"object","required":["schema","status","diagnostics","context","gate_result"],
      "properties":{"schema":{"const":"ParentContextPreparationV1"},"status":{"enum":["PREPARED_FOR_REVIEW","REVIEW"]},
        "diagnostics":{"type":"array","items":{"type":"object","required":["code"],"properties":{"code":{"type":"string"}}}},
        "context":{"oneOf":[{"type":"null"},{"type":"object","required":["file","sha256","utf8_bytes"],"properties":{"file":{"const":"context.txt"},"sha256":{"$ref":"#/$defs/sha256"},"utf8_bytes":{"type":"integer","minimum":0}}}]},
        "provider_wire_verified":{"const":false},"parent_completeness_verified":{"const":false},"human_labels":{"type":"null"},"gate_result":{"type":"null"}},
      "allOf":[{"if":{"properties":{"status":{"const":"REVIEW"}}},"then":{"properties":{"context":{"type":"null"},"diagnostics":{"minItems":1}}}},
        {"if":{"properties":{"status":{"const":"PREPARED_FOR_REVIEW"}}},"then":{"properties":{"context":{"type":"object"},"diagnostics":{"maxItems":0}}}}]
    },
    "response":{
      "type":"object","additionalProperties":false,"required":["schema","report","context_text"],
      "properties":{"schema":{"const":"ParentContextResponseV1"},"report":{"$ref":"#/$defs/report"},"context_text":{"type":["string","null"]}}
    }
  }
}
