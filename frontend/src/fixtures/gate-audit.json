    "path": "tests/test_gate_properties.py",
    "items": [
      {
        "test": "test_verdict_follows_threshold_rule_at_boundaries",
        "description": "阈值边界：恰等于阈值放行，低一个浮点步长、缺失或 NaN 拦截。"
      },
      {
        "test": "test_higher_scores_never_turn_pass_into_block",
        "description": "分数升高，放行不会变成拦截。"
      },
      {
        "test": "test_stricter_thresholds_never_turn_block_into_pass",
        "description": "阈值调高，拦截不会变成放行。"
      },
      {
        "test": "test_question_order_does_not_change_verdict",
        "description": "打乱题目顺序，正向均值与裁决都不变。"
      },
      {
        "test": "test_negative_cases_do_not_change_verdict",
        "description": "任意增加负向题、任意给分，正向均值与裁决都不变。"
      },
      {
        "test": "test_overall_means_including_negatives_do_not_change_verdict",
        "description": "含负向题的整体均值不影响裁决。"
      },
      {
        "test": "test_only_first_valid_model_is_judged",
        "description": "只裁决第一个有效模型，其前后的模型不影响结论。"
      },
      {
        "test": "test_single_case_warnings_list_low_cases_without_changing_verdict",
        "description": "单题告警如实列出低分题，且不改变裁决。"
      },
      {
        "test": "test_gate_log_reports_the_judged_model_and_means",
        "description": "门禁日志如实打印被裁决的模型与各项均值。"
      },
      {
        "test": "test_gate_does_not_modify_inputs",
        "description": "门禁不修改传入的汇总与逐题数据。"
      }
    ]
