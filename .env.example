# ===== DeepSeek 模型配置 =====
OPENAI_API_KEY=sk-在此填入你的DeepSeek密钥
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 硅基流动 Qwen 模型配置 =====
SILICONFLOW_API_KEY=sk-在此填入你的硅基流动密钥
QWEN_MODEL=Pro/Qwen/Qwen2.5-7B-Instruct
QWEN_BASE_URL=https://api.siliconflow.cn/v1

# ===== Embedding 模型（可选，默认 BAAI/bge-small-zh-v1.5）=====
