# 复制为 deploy/.env 后按需修改。不要提交真实密钥。

# 1 = 只读演示站（默认）：nginx 与后端都拒绝在线评测（HTTP 423），前端不显示评测入口。
# 0 = 可评测部署：需同时设置 API_INSTALL=full，并在下方填写模型密钥。
VERISCOPE_READ_ONLY=1

# demo = 只装 API 启动依赖（镜像小）；full = 安装 requirements.txt 全部依赖（真实评测需要）。
API_INSTALL=demo

# 端口与监听地址。默认只监听本机（127.0.0.1），公网访问建议前置 TLS 反向代理；
# 确需直接对外开放时改为 WEB_BIND=0.0.0.0，并确认服务器防火墙或安全组规则。
WEB_PORT=8080
WEB_BIND=127.0.0.1

# 以下仅在可评测部署（VERISCOPE_READ_ONLY=0）时需要，变量名与根目录 .env.example 一致。
# OPENAI_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# SILICONFLOW_API_KEY=
# QWEN_BASE_URL=https://api.siliconflow.cn/v1
